rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /essensliste/wa2a {
      allow read, delete: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['createdAt','expireAt','orders','anwesend','abendessenText','abendessenAktiv','brotzeitPreis','abendessenPreis','paypalEmail','hausl']);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
